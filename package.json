{
  "name": "api-comparison",
  "version": "1.0.0",
  "description": "Side-by-side comparison of REST, GraphQL, and gRPC using the same library domain",
  "scripts": {
    "rest":           "tsx rest/server.ts",
    "graphql":        "tsx graphql/server.ts",
    "grpc":           "tsx grpc/server.ts",
    "demo:rest":      "tsx demos/rest-demo.ts",
    "demo:graphql":   "tsx demos/graphql-demo.ts",
    "demo:grpc":      "tsx demos/grpc-demo.ts"
  },
  "dependencies": {
    "@apollo/server":      "^4.10.0",
    "@grpc/grpc-js":       "^1.10.0",
    "@grpc/proto-loader":  "^0.7.10",
    "cors":                "^2.8.5",
    "express":             "^4.18.0",
    "graphql":             "^16.8.0"
  },
  "devDependencies": {
    "@types/cors":    "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node":    "^20.11.0",
    "tsx":            "^4.7.0",
    "typescript":     "^5.3.0"
  }
}
